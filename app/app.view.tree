$bog_birthdaycase_app $mol_page
	title @ \Кейс-задача № 2
	body <= content /
	step? 1
	day? +NaN
	month? +NaN
	year? +NaN

	Day_step $mol_view
		sub /
			<= Day_title $mol_text
				text @ \Введите день рождения
			<= Day_input $mol_number
				value? <=> day? +NaN
				precision 1
				value_min 1
				value_max 31
			<= Day_next $mol_button_major
				title @ \Далее
				enabled <= day_valid
				click? <=> day_next? null

	Month_step $mol_view
		sub /
			<= Month_title $mol_text
				text @ \Введите месяц рождения
			<= Month_input $mol_number
				value? <=> month? +NaN
				precision 1
				value_min 1
				value_max 12
			<= Month_next $mol_button_major
				title @ \Далее
				enabled <= month_valid
				click? <=> month_next? null

	Year_step $mol_view
		sub /
			<= Year_title $mol_text
				text @ \Введите год рождения
			<= Year_input $mol_number
				value? <=> year? +NaN
				precision 1
				value_min 1
				value_max <= year_max
			<= Year_next $mol_button_major
				title @ \Показать результат
				enabled <= date_valid
				click? <=> year_next? null

	Result_step $mol_view
		sub /
			<= Result_text $mol_text
				text <= result_text \
			<= Leap_text $mol_text
				text <= leap_text \
			<= Age_text $mol_text
				text <= age_text \
			<= Display_title $mol_text
				text @ \Дата рождения на электронном табло
			<= Star_display $mol_textarea
				value <= star_art \
				enabled false
			<= Restart $mol_button_minor
				title @ \Ввести другую дату
				click? <=> restart? null
