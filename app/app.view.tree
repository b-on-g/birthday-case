$bog_birthdaycase_app $mol_page
	title @ \Кейс-задача № 2
	day? +NaN
	month? +NaN
	year? +NaN
	year_max 0
	date_valid false
	weekday_text \
	leap_text \
	age_text \
	star_art \
	show_result? null
	body /
		<= Day_title $mol_text
			text @ \Введите день рождения
		<= Day_input $mol_number
			value? <=> day? +NaN
			precision 1
			value_min 1
			value_max 31
		<= Month_title $mol_text
			text @ \Введите месяц рождения
		<= Month_input $mol_number
			value? <=> month? +NaN
			precision 1
			value_min 1
			value_max 12
		<= Year_title $mol_text
			text @ \Введите год рождения
		<= Year_input $mol_number
			value? <=> year? +NaN
			precision 1
			value_min 1
			value_max <= year_max
		<= Show_button $mol_button_major
			title @ \Показать результат
			enabled <= date_valid
			click? <=> show_result? null
		<= Weekday_info $mol_text
			text <= weekday_text \
		<= Leap_info $mol_text
			text <= leap_text \
		<= Age_info $mol_text
			text <= age_text \
		<= Display_title $mol_text
			text @ \Дата рождения на электронном табло
		<= Star_display $mol_textarea
			value <= star_art \
			enabled false
